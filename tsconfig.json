{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "./",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./apps/eflix-backend/tsconfig.app.json"
    },
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/movie-service/tsconfig.app.json"
    }
  ]
}