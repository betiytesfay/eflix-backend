FROM node:22-alpine

WORKDIR /usr/src/app

# Copy package descriptors first to take advantage of Docker layer caching
COPY package*.json ./
RUN npm install

# Copy monorepo source files
COPY . .

# Argument to select which service to run (default: user-service)
ARG APP_NAME=user-service
ENV APP_NAME=${APP_NAME}

# Run the selected service in hot-reload watch mode
CMD npx nest start ${APP_NAME} --watch
