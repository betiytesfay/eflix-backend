{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/eflix-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/eflix-backend/tsconfig.app.json",
    "builder": "tsc"
  },
  "monorepo": true,
  "root": "apps/eflix-backend",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "eflix-backend": {
      "type": "application",
      "root": "apps/eflix-backend",
      "entryFile": "main",
      "sourceRoot": "apps/eflix-backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/eflix-backend/tsconfig.app.json"
      }
    },
    "movie-service": {
      "type": "application",
      "root": "apps/movie-service",
      "entryFile": "main",
      "sourceRoot": "apps/movie-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/movie-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "subscription-service": {
      "type": "application",
      "root": "apps/subscription-service",
      "entryFile": "main",
      "sourceRoot": "apps/subscription-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/subscription-service/tsconfig.app.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    }
  }
}